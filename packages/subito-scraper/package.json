{
  "name": "mcp-server-subito-scraper",
  "version": "1.0.0",
  "description": "MCP (Model Context Protocol) server for scraping Subito.it ads using Apify Actor azzouzana/subito-scraper-pro-by-search-url",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-subito-scraper": "./dist/bin.js",
    "subito-scraper-mcp": "./dist/bin.js",
    "subito-scraper-batch": "./dist/batch-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js dist/batch-cli.js",
    "watch": "tsc --watch",
    "test": "tsx test/smoke-test.ts",
    "test:local": "tsx test/local.test.ts",
    "test:mcp": "npm run build && tsx test/test-mcp-client.ts",
    "start": "node dist/bin.js",
    "dev": "tsx src/bin.ts",
    "search-batch": "tsx src/batch-cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "subito",
    "subito-it",
    "scraper",
    "apify",
    "apify-actor",
    "ai",
    "claude",
    "gemini"
  ],
  "author": "Olindo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "apify-client": "^2.11.8",
    "axios": "^1.19.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "lru-cache": "^7.18.3",
    "shared-mcp-utils": "file:../shared-mcp-utils",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
